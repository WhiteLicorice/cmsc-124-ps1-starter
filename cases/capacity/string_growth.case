# Appending past the initial capacity has to grow the buffer, repeatedly.
str new s "0123456789"
str append s "0123456789"
str append s "0123456789"
str append s "0123456789"
str append s "0123456789"
str append s "0123456789"
str append s "0123456789"
str append s "0123456789"
str len s
str substr s 75 5 tail
print @tail
